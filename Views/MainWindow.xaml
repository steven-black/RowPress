<Window x:Class="Xemplate.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Xemplate"
        xmlns:views="clr-namespace:Xemplate.Views"
        xmlns:vm="clr-namespace:Xemplate.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Xemplate" Height="450" Width="800">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Button Content="Upload excel workbook" Command="{Binding BrowseExcelCommand}" />
            <TextBlock Text="{Binding ExcelDocumentPath}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />

            <TextBlock Text="Name of sheet to use:" />
            <TextBox Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

            <TextBlock Text="Columns to use for naming: (A; B; AA; AB)" />
            <TextBox Text="{Binding OutputDocumentNamingColumns, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

            <Button Content="Upload word template" Command="{Binding BrowseWordCommand}" />
            <TextBlock Text="{Binding WordDocumentPath}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />

            <TextBlock Text="Output document name:" />
            <TextBox Text="{Binding OutputDocumentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

            <Button Content="Select where output files should be saved" Command="{Binding BrowseFolderCommand}" />
            <TextBlock Text="{Binding OutputFolderPath}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />

            <CheckBox Content="Save as PDF" IsChecked="{Binding SaveAsPdf}" />
            
            <Button Content="Add placeholder and replacement" Command="{Binding AddPlaceholderCommand}" Margin="0,8,0,0" />

            <ItemsControl ItemsSource="{Binding PlaceholderRows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:PlaceholderRowControl />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Propagate" Command="{Binding PropagateCommand}" />

            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </ScrollViewer>
</Window>
